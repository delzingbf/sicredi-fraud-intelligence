# ─── IBM watsonx.ai ───────────────────────────────────────────────────────────

# Project reference (non-secret, safe to commit)
IBM_PROJECT_ID=e696fb51-b4b0-4e13-8478-c66e8e9002ed

# Authentication — choose ONE of the two options below:
#
# Option A (recommended): path to a private JSON file with {"apikey":"..."}
#   - Tokens are obtained and renewed automatically (no manual steps after setup)
#   - File must be outside the repository and never committed
#   - Takes precedence over IBM_ACCESS_TOKEN when set
#   - See docs/IBM_WATSONX_SETUP.md § "Autenticação automática com JSON local"
#
IBM_API_KEY_FILE=/absolute/private/path/ibm-api-key.json
#
# Option B (manual fallback): paste an IAM bearer token directly
#   - Expires in ~1h; must be renewed manually and the API restarted
#   - Use only when IBM_API_KEY_FILE is not available
#   - NEVER commit a real token here
#   - See docs/IBM_WATSONX_SETUP.md § "Início rápido — sessões futuras (modo manual)"
#
# IBM_ACCESS_TOKEN=

# IBM Chat API
IBM_CHAT_API_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/chat?version=2024-10-08
IBM_MODEL_ID=ibm/granite-4-h-small

# ─── NestJS server ────────────────────────────────────────────────────────────

PORT=3001

# ─── Agent behaviour ──────────────────────────────────────────────────────────

MAX_INVESTIGATION_ROUNDS=8
INVESTIGATION_TIMEOUT_MS=30000

# ─── PostgreSQL — local development (Docker Compose) ─────────────────────────

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://fraudlens:fraudlens@localhost:5432/fraudlens
