# IBM watsonx.ai — project reference (non-secret, safe to commit)
IBM_PROJECT_ID=e696fb51-b4b0-4e13-8478-c66e8e9002ed

# IBM watsonx.ai — IAM bearer token (~1h TTL, generated at runtime)
# Generate via: see docs/IBM_WATSONX_SETUP.md
# NEVER commit a real token here
IBM_ACCESS_TOKEN=

# IBM watsonx.ai Chat API
IBM_CHAT_API_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/chat?version=2024-10-08
IBM_MODEL_ID=ibm/granite-4-h-small

# NestJS server
PORT=3001

# Agent behaviour
MAX_INVESTIGATION_ROUNDS=8

# PostgreSQL — local development (Docker Compose)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://fraudlens:fraudlens@localhost:5432/fraudlens
