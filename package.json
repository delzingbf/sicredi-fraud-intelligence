{
  "name": "sicredi-fraud-intelligence",
  "private": true,
  "version": "0.0.0",
  "description": "Hello Moto — Sicredi Fraud Intelligence MVP",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @fraud-intelligence/api --filter @fraud-intelligence/web run start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.4",
    "pg": "^8.13.1",
    "pg-copy-streams": "^6.0.6",
    "typescript": "^5.4.5"
  }
}
